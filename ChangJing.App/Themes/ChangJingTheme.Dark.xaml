<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色调色板，与 Light 结构一致仅换值，由 ThemeService 在系统切深色时整体替换 -->

    <Color x:Key="CjWindowBackgroundColor">#FF1E1F22</Color>
    <Color x:Key="CjCardBackgroundColor">#FF2B2D31</Color>
    <Color x:Key="CjCardBorderColor">#FF3A3D42</Color>
    <Color x:Key="CjAccentColor">#FF2563EB</Color>
    <Color x:Key="CjAccentHoverColor">#FF3B82F6</Color>
    <Color x:Key="CjAccentPressedColor">#FF1D4ED8</Color>
    <Color x:Key="CjSelectionBackgroundColor">#522563EB</Color>
    <Color x:Key="CjHoverBackgroundColor">#FF3A3E44</Color>
    <Color x:Key="CjInputBackgroundColor">#FF232529</Color>
    <Color x:Key="CjHeaderBackgroundColor">#FF232529</Color>
    <Color x:Key="CjTextPrimaryColor">#FFE6E8EB</Color>
    <Color x:Key="CjTextSecondaryColor">#FF9AA1AC</Color>
    <Color x:Key="CjDisabledTextColor">#FF6B7280</Color>
    <Color x:Key="CjWarningColor">#FFEA7A12</Color>
    <Color x:Key="CjDangerColor">#FFFF6B5E</Color>
    <Color x:Key="CjBadgeBackgroundColor">#FF4A3318</Color>
    <Color x:Key="CjBadgeForegroundColor">#FFF0A857</Color>
    <Color x:Key="CjHintBackgroundColor">#FF3A2E17</Color>
    <Color x:Key="CjHintBorderColor">#FF5A4520</Color>
    <Color x:Key="CjHintForegroundColor">#FFF0C889</Color>
    <Color x:Key="CjSplitterHoverColor">#FF4A4E55</Color>

    <Color x:Key="CjDriveProgressColor">#FF3B82F6</Color>
    <Color x:Key="CjDriveProgressLowColor">#FFFF6B5E</Color>
    <Color x:Key="CjDriveProgressTrackColor">#FF3A3D42</Color>

    <SolidColorBrush x:Key="CjWindowBackgroundBrush" Color="{StaticResource CjWindowBackgroundColor}" />
    <SolidColorBrush x:Key="CjCardBackgroundBrush" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="CjCardBorderBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="CjAccentBrush" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="CjAccentHoverBrush" Color="{StaticResource CjAccentHoverColor}" />
    <SolidColorBrush x:Key="CjAccentPressedBrush" Color="{StaticResource CjAccentPressedColor}" />
    <SolidColorBrush x:Key="CjSelectionBackgroundBrush" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="CjHoverBackgroundBrush" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="CjInputBackgroundBrush" Color="{StaticResource CjInputBackgroundColor}" />
    <SolidColorBrush x:Key="CjHeaderBackgroundBrush" Color="{StaticResource CjHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="CjTextPrimaryBrush" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="CjTextSecondaryBrush" Color="{StaticResource CjTextSecondaryColor}" />
    <SolidColorBrush x:Key="CjDisabledTextBrush" Color="{StaticResource CjDisabledTextColor}" />
    <SolidColorBrush x:Key="CjWarningBrush" Color="{StaticResource CjWarningColor}" />
    <SolidColorBrush x:Key="CjDangerBrush" Color="{StaticResource CjDangerColor}" />
    <SolidColorBrush x:Key="CjBadgeBackgroundBrush" Color="{StaticResource CjBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="CjBadgeForegroundBrush" Color="{StaticResource CjBadgeForegroundColor}" />
    <SolidColorBrush x:Key="CjHintBackgroundBrush" Color="{StaticResource CjHintBackgroundColor}" />
    <SolidColorBrush x:Key="CjHintBorderBrush" Color="{StaticResource CjHintBorderColor}" />
    <SolidColorBrush x:Key="CjHintForegroundBrush" Color="{StaticResource CjHintForegroundColor}" />
    <SolidColorBrush x:Key="CjSplitterHoverBrush" Color="{StaticResource CjSplitterHoverColor}" />
    <SolidColorBrush x:Key="CjOnAccentBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="CjDriveProgressBrush" Color="{StaticResource CjDriveProgressColor}" />
    <SolidColorBrush x:Key="CjDriveProgressLowBrush" Color="{StaticResource CjDriveProgressLowColor}" />
    <SolidColorBrush x:Key="CjDriveProgressTrackBrush" Color="{StaticResource CjDriveProgressTrackColor}" />

    <SolidColorBrush x:Key="CjTileSelectionBorderBrush" Color="{StaticResource CjAccentColor}" Opacity="0.70" />
    <SolidColorBrush x:Key="CjPanelDividerBrush" Color="{StaticResource CjCardBorderColor}" />

    <SolidColorBrush x:Key="CjSearchHighlightBrush" Color="{StaticResource CjAccentColor}" Opacity="0.55" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource CjTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource CjTextSecondaryColor}" />
    <Color x:Key="TextFillColorPrimary">#FFE6E8EB</Color>
    <Color x:Key="TextFillColorSecondary">#FF9AA1AC</Color>
    <Color x:Key="TextFillColorTertiary">#FF9AA1AC</Color>

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource CjWindowBackgroundColor}" />
    <Color x:Key="ApplicationBackgroundColor">#FF1E1F22</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource CjWindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource CjTextPrimaryColor}" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource CjWindowBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource CjHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource CjInputBackgroundColor}" />

    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="MenuBarItemBorderBrush" Color="{StaticResource CjCardBorderColor}" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource CjInputBackgroundColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource CjHoverBackgroundColor}" />

    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource CjInputBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource CjInputBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource CjTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource CjAccentColor}" />

    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource CjDisabledTextColor}" />
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource CjInputBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource CjSelectionBackgroundColor}" />

    <!-- 禁用填充 / 描边一律 Transparent，深浅两份调色板键集必须一致 -->
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{StaticResource CjDisabledTextColor}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{StaticResource CjDisabledTextColor}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="{StaticResource CjDisabledTextColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource CjDisabledTextColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="{StaticResource CjDisabledTextColor}" />

    <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource CjAccentColor}" />

    <SolidColorBrush x:Key="TreeViewItemForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="{StaticResource CjAccentColor}" />

    <SolidColorBrush x:Key="ListBoxItemForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="TabViewItemForegroundSelected" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedBackground" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedBackgroundPointerOver" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{StaticResource CjAccentColor}" />
    <Color x:Key="TextOnAccentFillColorSelectedText">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="ContextMenuBackground" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{StaticResource CjHoverBackgroundColor}" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{StaticResource CjSelectionBackgroundColor}" />
    <SolidColorBrush x:Key="MenuBarItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="MenuBarBackground" Color="{StaticResource CjWindowBackgroundColor}" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource CjCardBorderColor}" />

    <SolidColorBrush x:Key="MessageBoxBackground" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="MessageBoxForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="MessageBoxSeparatorBorderBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource CjTextPrimaryColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource CjCardBorderColor}" />

    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource CjCardBorderColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource CjAccentHoverColor}" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource CjCardBackgroundColor}" />
    <SolidColorBrush x:Key="SliderTickBarFill" Color="{StaticResource CjTextSecondaryColor}" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource CjAccentHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource CjAccentPressedColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{StaticResource CjDisabledTextColor}" />

    <Color x:Key="SystemFillColorAttention">#FF2563EB</Color>
    <Color x:Key="SystemFillColorCaution">#FFEA7A12</Color>
    <Color x:Key="SystemFillColorCritical">#FFFF6B5E</Color>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource CjAccentColor}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource CjWarningColor}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource CjBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource CjDangerColor}" />

    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource CjAccentColor}" />

    <!-- 去掉 ScrollViewer 右下角系统灰白方块，改为卡片底色 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource CjCardBackgroundColor}" />
</ResourceDictionary>
