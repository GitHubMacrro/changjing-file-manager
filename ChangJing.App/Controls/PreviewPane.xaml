<UserControl x:Class="ChangJing.App.Controls.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ChangJing.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="520"
             FontFamily="{x:Static SystemFonts.MessageFontFamily}"
             FontSize="{x:Static SystemFonts.MessageFontSize}"
             AutomationProperties.AutomationId="PreviewPane"
             AutomationProperties.Name="预览窗格">
    <Grid Background="{DynamicResource CjCardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="PreviewArea" Grid.Row="0" ClipToBounds="True">
            <controls:SystemPreviewHost x:Name="PreviewPaneSystem"
                                        Visibility="Collapsed"
                                        AutomationProperties.AutomationId="PreviewPaneSystem"
                                        AutomationProperties.Name="系统预览" />

            <ScrollViewer x:Name="PreviewPaneImage"
                          Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AutomationProperties.AutomationId="PreviewPaneImage"
                          AutomationProperties.Name="图片预览">
                <Image x:Name="PreviewImage"
                       Margin="4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                       MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
            </ScrollViewer>

            <Grid x:Name="PreviewPaneText"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="PreviewPaneText"
                  AutomationProperties.Name="文本预览">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextHeader"
                           Grid.Row="0"
                           Margin="8,6,8,2"
                           FontSize="11"
                           Foreground="{DynamicResource CjTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="TextBody"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Padding="8,2,8,8"
                         Background="Transparent"
                         Foreground="{DynamicResource CjTextPrimaryBrush}"
                         FontFamily="Consolas, Cascadia Mono, Courier New"
                         AutomationProperties.AutomationId="PreviewPaneTextBody"
                         AutomationProperties.Name="文本内容" />
            </Grid>

            <Grid x:Name="PreviewPanePdf"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="PreviewPanePdf"
                  AutomationProperties.Name="PDF 预览">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image x:Name="PdfImage"
                       Grid.Row="0"
                       Margin="4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform" />
                <Border Grid.Row="1"
                        Margin="0,2,0,0"
                        Padding="8,4"
                        BorderBrush="{DynamicResource CjCardBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button x:Name="PreviewPanePdfPrevButton"
                                   Content="◀ 上一页"
                                   Style="{StaticResource CjSecondaryButtonStyle}"
                                   Padding="8,2"
                                   FontSize="12"
                                   Click="OnPdfPrevClick"
                                   AutomationProperties.AutomationId="PreviewPanePdfPrevButton"
                                   AutomationProperties.Name="上一页" />
                        <TextBlock x:Name="PreviewPanePdfPageLabel"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource CjTextSecondaryBrush}"
                                   AutomationProperties.AutomationId="PreviewPanePdfPageLabel"
                                   AutomationProperties.Name="页码" />
                        <ui:Button x:Name="PreviewPanePdfNextButton"
                                   Content="下一页 ▶"
                                   Style="{StaticResource CjSecondaryButtonStyle}"
                                   Padding="8,2"
                                   FontSize="12"
                                   Click="OnPdfNextClick"
                                   AutomationProperties.AutomationId="PreviewPanePdfNextButton"
                                   AutomationProperties.Name="下一页" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="PreviewPaneOther"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="PreviewPaneOther"
                  AutomationProperties.Name="其他预览">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16"
                                MaxWidth="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Image x:Name="OtherIcon"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center" />
                        <TextBlock x:Name="OtherName"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CjTextPrimaryBrush}" />
                        <TextBlock x:Name="OtherMeta"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CjTextSecondaryBrush}" />
                        <TextBlock x:Name="OtherModified"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource CjTextSecondaryBrush}" />
                        <TextBlock x:Name="OtherPath"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CjTextSecondaryBrush}" />
                        <TextBlock x:Name="OtherHint"
                                   Margin="0,10,0,0"
                                   Padding="8,6"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Background="{DynamicResource CjHintBackgroundBrush}"
                                   Foreground="{DynamicResource CjHintForegroundBrush}" />
                        <ui:Button x:Name="PreviewPaneRepairButton"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource CjSecondaryButtonStyle}"
                                   Content="修复…"
                                   Visibility="Collapsed"
                                   ToolTip="修复超长路径或让资源管理器无法处理的问题"
                                   Click="OnRepairClick"
                                   AutomationProperties.AutomationId="PreviewPaneRepairButton"
                                   AutomationProperties.Name="修复路径" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="PreviewPaneMessage"
                    Background="{DynamicResource CjCardBackgroundBrush}"
                    AutomationProperties.AutomationId="PreviewPaneMessage"
                    AutomationProperties.Name="预览提示">
                <TextBlock x:Name="MessageText"
                           Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource CjTextSecondaryBrush}"
                           Text="选择文件以预览" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="8"
                BorderBrush="{DynamicResource CjCardBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PreviewPaneOpenButton"
                           Content="打开"
                           Style="{StaticResource CjSecondaryButtonStyle}"
                           Margin="0,0,8,0"
                           Click="OnOpenClick"
                           AutomationProperties.AutomationId="PreviewPaneOpenButton"
                           AutomationProperties.Name="打开" />
                <ui:Button x:Name="PreviewPaneCopyButton"
                           Content="复制到桌面"
                           Style="{StaticResource CjSecondaryButtonStyle}"
                           Click="OnCopyToDesktopClick"
                           AutomationProperties.AutomationId="PreviewPaneCopyButton"
                           AutomationProperties.Name="复制到桌面" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
