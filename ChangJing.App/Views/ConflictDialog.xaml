<ui:FluentWindow x:Class="ChangJing.App.Views.ConflictDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="确认替换或跳过文件"
                 Width="640"
                 SizeToContent="Height"
                 MaxHeight="560"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Background="{DynamicResource CjCardBackgroundBrush}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource CjCardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="确认替换或跳过文件"
                     Background="{DynamicResource CjCardBackgroundBrush}"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <TextBlock x:Name="PromptText"
                   Grid.Row="1"
                   Margin="24,12,24,0"
                   FontSize="{x:Static SystemFonts.MessageFontSize}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="已存在（目标）" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Image x:Name="TargetIcon"
                               Width="20"
                               Height="20"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TargetName"
                                   VerticalAlignment="Center"
                                   FontSize="{x:Static SystemFonts.MessageFontSize}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="TargetSize"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TargetModified"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="将要放入（源）" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Image x:Name="SourceIcon"
                               Width="20"
                               Height="20"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="SourceName"
                                   VerticalAlignment="Center"
                                   FontSize="{x:Static SystemFonts.MessageFontSize}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="SourceSize"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceModified"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="24,14,24,0">
            <TextBlock x:Name="KeepBothHint"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <CheckBox x:Name="ApplyToAllCheck"
                      Margin="0,10,0,0"
                      FontSize="12"
                      Content="对其余冲突执行此操作" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="24,20,24,20"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button x:Name="ReplaceButton"
                       MinWidth="88"
                       Style="{StaticResource CjSecondaryButtonStyle}"
                       Click="OnReplaceClick"
                       Content="替换" />
            <ui:Button x:Name="SkipButton"
                       MinWidth="88"
                       Margin="8,0,0,0"
                       Style="{StaticResource CjSecondaryButtonStyle}"
                       Click="OnSkipClick"
                       Content="跳过" />
            <ui:Button x:Name="KeepBothButton"
                       MinWidth="110"
                       Margin="8,0,0,0"
                       Style="{StaticResource CjPrimaryButtonStyle}"
                       Click="OnKeepBothClick"
                       Content="保留两者" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
