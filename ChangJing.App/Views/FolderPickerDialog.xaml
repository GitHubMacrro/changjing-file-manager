<ui:FluentWindow x:Class="ChangJing.App.Views.FolderPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:ChangJing.App.ViewModels"
                 Title="选择文件夹"
                 Width="680"
                 Height="560"
                 MinWidth="520"
                 MinHeight="400"
                 ShowInTaskbar="False"
                 Background="{DynamicResource CjCardBackgroundBrush}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource CjCardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="选择文件夹"
                     Background="{DynamicResource CjCardBackgroundBrush}"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <ScrollViewer Grid.Row="1"
                      Margin="20,10,20,0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BreadcrumbList"
                          AutomationProperties.AutomationId="FolderPickerBreadcrumbs"
                          ItemsSource="{Binding BreadcrumbSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="4,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Tag="{Binding Target}"
                                    ToolTip="{Binding Target}"
                                    Click="OnBreadcrumbClick">
                                <TextBlock Text="{Binding DisplayName}" />
                            </Button>
                            <TextBlock Margin="1,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="›" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="20,8,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="{x:Static SystemFonts.MessageFontSize}"
                       Text="位置：" />

            <TextBox x:Name="PathBox"
                     Grid.Column="1"
                     AutomationProperties.AutomationId="FolderPickerPathBox"
                     AutomationProperties.Name="当前路径"
                     Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnPathBoxKeyDown"
                     VerticalContentAlignment="Center" />

            <ui:Button Grid.Column="2"
                       MinWidth="72"
                       Margin="8,0,0,0"
                       Click="OnGoUpClick"
                       Content="上一级"
                       IsEnabled="{Binding CanGoUp}"
                       Icon="{ui:SymbolIcon ArrowUp20}" />
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Margin="20,6,20,0"
                   FontSize="12"
                   Foreground="{DynamicResource CjDangerBrush}"
                   Text="{Binding PathError}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasPathError, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="4"
                Margin="20,10,20,0"
                BorderBrush="{DynamicResource CjCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CjInputCornerRadius}">
            <ListBox x:Name="FolderList"
                     AutomationProperties.AutomationId="FolderPickerList"
                     AutomationProperties.Name="子文件夹列表"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListMouseDoubleClick"
                     KeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CjListBoxItemStyle}" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderBrowserEntry}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16"
                                   Height="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding Icon}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayPath}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="5" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="NewFolderButton"
                       Grid.Column="0"
                       HorizontalAlignment="Left"
                       Style="{StaticResource CjSecondaryButtonStyle}"
                       Click="OnNewFolderClick"
                       Content="新建文件夹"
                       Icon="{ui:SymbolIcon Folder20}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="ConfirmButton"
                           MinWidth="88"
                           Style="{StaticResource CjPrimaryButtonStyle}"
                           Click="OnConfirmClick"
                           Content="确定"
                           IsEnabled="{Binding CanConfirm}" />
                <ui:Button MinWidth="88"
                           Margin="8,0,0,0"
                           Style="{StaticResource CjSecondaryButtonStyle}"
                           Click="OnCancelClick"
                           Content="取消" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
