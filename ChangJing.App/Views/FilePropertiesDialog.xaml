<ui:FluentWindow x:Class="ChangJing.App.Views.FilePropertiesDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="属性"
                 Width="520"
                 SizeToContent="Height"
                 MinWidth="440"
                 ShowInTaskbar="False"
                 Background="{DynamicResource CjCardBackgroundBrush}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                 FontSize="{x:Static SystemFonts.MessageFontSize}">
    <Grid Background="{DynamicResource CjCardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="属性"
                     Background="{DynamicResource CjCardBackgroundBrush}"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="20,10,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="48"
                   Height="48"
                   Margin="0,0,12,0"
                   VerticalAlignment="Top"
                   Source="{Binding Icon}" />

            <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource CjTextSecondaryBrush}"
                           Text="{Binding DisplayPath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayPath}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="20,8,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="88" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="名称" />
            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="完整路径" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding DisplayPath}" TextWrapping="Wrap" ToolTip="{Binding DisplayPath}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="路径长度" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding PathLengthText}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="类型" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding TypeName}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="大小" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding SizeText}" TextWrapping="Wrap" />
            <ui:Button Grid.Row="4" Grid.Column="2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Content="取消计算"
                       Style="{StaticResource CjSecondaryButtonStyle}"
                       Click="OnCancelSizeClick"
                       Visibility="{Binding IsSizeCalculating, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="创建时间" />
            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding CreationTimeText}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="修改时间" />
            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding LastWriteTimeText}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="访问时间" />
            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding LastAccessTimeText}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropertyLabelStyle}" Text="属性" />
            <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PropertyValueStyle}"
                       Text="{Binding AttributesText}" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</ui:FluentWindow>
