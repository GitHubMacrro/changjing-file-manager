<ui:FluentWindow x:Class="ChangJing.App.Views.ShortcutTargetDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="新建快捷方式"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Background="{DynamicResource CjWindowBackgroundBrush}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                 FontSize="{x:Static SystemFonts.MessageFontSize}">
    <Grid Background="{DynamicResource CjWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     Title="新建快捷方式"
                     Background="{DynamicResource CjWindowBackgroundBrush}"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <TextBlock Grid.Row="1"
                   Margin="20,10,20,0"
                   FontWeight="SemiBold"
                   Text="选择快捷方式的目标"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2"
                   Margin="20,4,20,0"
                   FontSize="12"
                   Foreground="{DynamicResource CjTextSecondaryBrush}"
                   Text="可输入文件或文件夹的完整路径。"
                   TextWrapping="Wrap" />

        <TextBox x:Name="PathBox"
                 Grid.Row="3"
                 Margin="20,10,20,0"
                 AutomationProperties.AutomationId="ShortcutTargetPathBox"
                 AutomationProperties.Name="快捷方式目标路径"
                 VerticalContentAlignment="Center"
                 KeyDown="OnPathKeyDown" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="4"
                   Margin="20,6,20,0"
                   FontSize="12"
                   Foreground="{DynamicResource CjDangerBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="5"
                    Margin="20,14,20,18"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button x:Name="CancelButton"
                       MinWidth="88"
                       Style="{StaticResource CjSecondaryButtonStyle}"
                       Click="OnCancelClick"
                       Content="取消" />
            <ui:Button x:Name="OkButton"
                       MinWidth="88"
                       Margin="8,0,0,0"
                       Style="{StaticResource CjPrimaryButtonStyle}"
                       AutomationProperties.AutomationId="ShortcutTargetOkButton"
                       AutomationProperties.Name="确定"
                       Click="OnOkClick"
                       Content="确定"
                       IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
