<ui:FluentWindow x:Class="ChangJing.App.Views.CopyMoveTargetDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="复制到"
                 Width="580"
                 SizeToContent="Height"
                 MaxHeight="660"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Background="{DynamicResource CjCardBackgroundBrush}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource CjCardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     x:Name="TargetTitleBar"
                     Title="复制到"
                     Background="{DynamicResource CjCardBackgroundBrush}"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="False" />

        <TextBlock Grid.Row="1"
                   Margin="20,10,20,0"
                   FontSize="{x:Static SystemFonts.MessageFontSize}"
                   FontWeight="SemiBold"
                   Text="{Binding SelectedCountText}" />

        <ListBox x:Name="TargetList"
                 Grid.Row="2"
                 Margin="20,10,20,0"
                 MinHeight="220"
                 MaxHeight="380"
                 AutomationProperties.AutomationId="CopyMoveTargetList"
                 AutomationProperties.Name="目标位置"
                 BorderBrush="{DynamicResource CjCardBorderBrush}"
                 BorderThickness="1"
                 ItemsSource="{Binding TargetsView}"
                 SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                 MouseDoubleClick="OnTargetListDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CjListBoxItemStyle}" />
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="2,8,2,2"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Width="16"
                               Height="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Source="{Binding Icon}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ToolTip}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding DetailText}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="SpaceHintText"
                   Grid.Row="3"
                   Margin="20,8,20,0"
                   FontSize="12"
                   Foreground="{DynamicResource CjDangerBrush}"
                   Text="{Binding SpaceHint}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasSpaceWarning, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="4" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="OtherLocationButton"
                       Grid.Column="0"
                       HorizontalAlignment="Left"
                       Style="{StaticResource CjSecondaryButtonStyle}"
                       Click="OnOtherLocationClick"
                       Content="其他位置…"
                       Icon="{ui:SymbolIcon Folder20}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="ConfirmButton"
                           MinWidth="120"
                           Style="{StaticResource CjPrimaryButtonStyle}"
                           Click="OnConfirmClick"
                           Content="{Binding PrimaryButtonText}"
                           IsEnabled="{Binding CanConfirm}" />
                <ui:Button MinWidth="88"
                           Margin="8,0,0,0"
                           Style="{StaticResource CjSecondaryButtonStyle}"
                           Click="OnCancelClick"
                           Content="取消" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
